# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-key-here

# API Base URL
# - For OpenAI API:        https://api.openai.com/v1
# - For LM Studio (Mac):   http://host.docker.internal:1234/v1
# - For LM Studio (Linux): http://172.17.0.1:1234/v1
OPENAI_API_BASE=https://api.openai.com/v1

# LLM Model for answer generation
# OpenAI examples: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Local examples:  qwen2.5-7b-instruct-mlx, llama-3.2-3b-instruct
OPENAI_MODEL=gpt-4o-mini

# Embedding Model
# OpenAI examples: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Local examples:  text-embedding-bge-large-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Internal Services (Kubernetes cluster)
WEAVIATE_URL=http://weaviate:8080
KAFKA_BOOTSTRAP=kafka:9092
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
REDIS_URL=redis://redis:6379

# gRPC Services (internal)
EMBEDDING_SERVICE_ADDR=embedding-service:50051
SEARCH_SERVICE_ADDR=search-service:50052

# Local Development (when running outside Kubernetes)
# Uncomment these when developing locally:
# WEAVIATE_URL=http://localhost:8081
# KAFKA_BOOTSTRAP=localhost:9092
# REDIS_URL=redis://localhost:6379
# EMBEDDING_SERVICE_ADDR=localhost:50051
# SEARCH_SERVICE_ADDR=localhost:50052

# Application Configuration
LOG_LEVEL=INFO
CACHE_TTL=3600

# =============================================================================
# Observability Stack
# =============================================================================
# Master switch for the entire observability stack.
# When disabled, the following are NOT deployed:
#   - Prometheus, Grafana, Tempo, Loki, Alloy
#   - kube-state-metrics, node-exporter
#   - Kubernetes Dashboard
# Services will skip OTel metrics export but still expose /metrics endpoints.
OBSERVABILITY_ENABLED=true

# OpenTelemetry Metrics (exported to Grafana Alloy)
# Only used when OBSERVABILITY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=xrag-alloy:4317
