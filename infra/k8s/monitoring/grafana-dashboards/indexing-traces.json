    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "description": "End-to-end traces showing document flow from ingestion through indexing",
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 1},
      "id": 1,
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "queryType": "traceqlSearch",
          "limit": 50,
          "refId": "A",
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "operator": "=~",
              "scope": "resource",
              "value": ["${service:raw}"],
              "valueType": "string"
            },
            {
              "id": "operation-filter",
              "tag": "name",
              "operator": "=~",
              "scope": "span",
              "value": ["${operation:raw}"],
              "valueType": "string"
            }
          ]
        }
      ],
      "title": "Indexing Traces",
      "type": "table",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "traceID"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Full Trace",
                    "url": "/explore?orgId=1&left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22,%22refId%22:%22A%22%7D%5D%7D"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "durationMs"},
            "properties": [{"id": "unit", "value": "ms"}]
          }
        ]
      },
      "transformations": []
    },
