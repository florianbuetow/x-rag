    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 1},
      "id": 1,
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "queryType": "nativeSearch",
          "serviceName": "${service:raw}",
          "limit": 50,
          "refId": "A"
        }
      ],
      "title": "Recent Traces",
      "type": "table",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "traceID"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace",
                    "url": "/explore?orgId=1&left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22,%22refId%22:%22A%22%7D%5D%7D"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "durationMs"},
            "properties": [{"id": "unit", "value": "ms"}]
          }
        ]
      },
      "transformations": []
    },
    {
